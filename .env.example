# KrishiMitra AI - Environment Configuration Example
# Copy this file to .env and replace placeholder values with your real keys

# Flask Configuration
SECRET_KEY=krishimitra_secure_session_key_2026_hackathon
FLASK_ENV=development
DEBUG=True

# Database Configuration
DATABASE_URI=sqlite:///database.db

# OpenWeatherMap API Key (Free tier available at https://openweathermap.org/api)
WEATHER_API_KEY=your_openweather_api_key_here

# Open Government Data (data.gov.in) API Key for Indian Mandi Market Prices (Optional)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Google Gemini API Key for Farming Assistant (Optional - Fallback rule-based knowledge engine works automatically)
GEMINI_API_KEY=your_gemini_api_key_here
